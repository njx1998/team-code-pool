/**
 * index.wxss —— 全部颜色走 app.wxss 里的 CSS 变量色阶
 * 换主题只改 app.wxss 一处，本文件不用动
 * 对比度：实心按钮 #0b8f52 + 白字 = 4.2:1；浅绿底 #e7f7ee + 深绿字 #0a7d4a = 4.7:1
 */

.page {
  min-height: 100vh;
  background: var(--bg-page, #f6f7f9);
  padding-bottom: 60rpx;
}

/* ===== 统计条 ===== */
.stats-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding: 28rpx 12rpx;
}
.stat-cell {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
}
.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary, #5f6771);
}
.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--brand-500, #0cae63);
  margin: 0 4rpx;
}
.stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: var(--border-light, #eceff2);
}

/* ===== 公告条 ===== */
.notice-bar {
  margin: 0 24rpx 16rpx;
  background: var(--bg-subtle, #f0f1f4);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
}
.notice-icon {
  color: var(--text-tertiary, #8a9099);
  font-size: 24rpx;
  margin-right: 10rpx;
}
.notice-text {
  font-size: 24rpx;
  color: var(--text-tertiary, #8a9099);
  flex: 1;
}

/* ===== 账号状态 ===== */
.account-row {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row-hover {
  background: var(--bg-page, #f6f7f9);
}
.account-left {
  display: flex;
  align-items: center;
}
.account-label {
  font-size: 28rpx;
  color: var(--text-primary, #1f2329);
  margin-right: 24rpx;
}
.account-status {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--brand-600, #0b8f52);
}
.account-more {
  font-size: 26rpx;
  color: var(--text-tertiary, #8a9099);
}

/* ===== 通用卡片 ===== */
.card {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
}

/* ===== 发码卡片 ===== */
.submit-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary, #1f2329);
  margin-bottom: 24rpx;
}
.submit-row {
  display: flex;
  align-items: center;
}
.submit-input {
  flex: 1;
  height: 88rpx;
  background: var(--bg-page, #f6f7f9);
  border: 1rpx solid var(--border-input, #e7e9ec);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary, #1f2329);
  box-sizing: border-box;
}
.input-placeholder {
  color: var(--text-placeholder, #b8bec6);
}
.submit-btn {
  margin-left: 20rpx;
  width: 180rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--brand-600, #0b8f52);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 12rpx;
  padding: 0;
}
.submit-btn::after {
  border: none;
}
/* 按压态：新手最容易漏的一处，没有它会觉得点不动的 */
.submit-btn-hover {
  background: var(--brand-800, #08663c);
}

/* ===== 折叠面板条 ===== */
.fold-bar {
  margin: 0 40rpx;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
}
.fold-hover {
  background: rgba(0, 0, 0, 0.03);
}
.fold-icon {
  color: var(--text-tertiary, #8a9099);
  font-size: 26rpx;
  margin-right: 12rpx;
}
.fold-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary, #1f2329);
}
.fold-toggle {
  font-size: 26rpx;
  color: var(--text-tertiary, #8a9099);
}

/* ===== 参与教程内容 ===== */
.tutorial {
  margin: 0 40rpx 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
}
.tut-item {
  font-size: 26rpx;
  color: var(--text-secondary, #5f6771);
  line-height: 1.8;
}

/* ===== 标签行（我的记录 / 互助池共用） ===== */
.tab-row {
  display: flex;
  border-bottom: 1rpx solid var(--bg-subtle, #f0f1f4);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary, #5f6771);
  position: relative;
}
.tab-active {
  color: var(--brand-600, #0b8f52);
  font-weight: bold;
}
.tab-active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand-600, #0b8f52);
}

/* ===== 我的记录 ===== */
.records {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}
.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f5f6f8;
}
.record-code {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary, #1f2329);
}
.record-right {
  display: flex;
  align-items: center;
}
.record-date {
  font-size: 24rpx;
  color: var(--text-tertiary, #8a9099);
}
.report-link {
  font-size: 24rpx;
  color: var(--danger, #cf2e2e);
  margin-left: 20rpx;
}
.link-hover {
  opacity: 0.6;
}

/* ===== 互助池 ===== */
.pool-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.pool-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary, #1f2329);
}
.pool-avail {
  font-size: 24rpx;
  color: var(--text-tertiary, #8a9099);
}
.pool-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid #f5f6f8;
}
.pool-info {
  display: flex;
  flex-direction: column;
}
.pool-code {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-primary, #1f2329);
}
.pool-meta {
  font-size: 24rpx;
  color: var(--text-tertiary, #8a9099);
  margin-top: 10rpx;
}

/* 状态胶囊：可用=浅绿底深绿字，已用=灰底但文字仍可读 */
.pill {
  width: 120rpx;
  height: 56rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pill-copy {
  background: var(--brand-100, #e7f7ee);
  color: var(--brand-700, #0a7d4a);
  font-weight: bold;
}
.pill-copy-hover {
  background: var(--brand-200, #cfeedd);
}
.pill-used {
  background: var(--bg-muted, #f2f3f5);
  color: var(--text-disabled, #8a9099);
}
.pool-empty {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-placeholder, #b8bec6);
  font-size: 26rpx;
}

/* ===== 互助池空态 ===== */
.pool-empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 40rpx 50rpx;
}
.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary, #1f2329);
}
.empty-sub {
  font-size: 26rpx;
  color: var(--text-tertiary, #8a9099);
  margin-top: 20rpx;
}
.empty-btn {
  margin-top: 44rpx;
  width: 400rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--brand-100, #e7f7ee);
  color: var(--brand-700, #0a7d4a);
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-btn-hover {
  background: var(--brand-200, #cfeedd);
}
.empty-link {
  margin-top: 36rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #5f6771);
}

/* ===== 页脚 ===== */
.page-footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
  font-size: 24rpx;
  color: var(--text-placeholder, #b8bec6);
}

/* ===== 复制弹窗 ===== */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 620rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
}
/* 弹窗头部改浅底深字 + 一条绿线：大面积高饱和色块会压住正文 */
.modal-head {
  background: #fff;
  border-bottom: 2rpx solid var(--brand-600, #0b8f52);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}
.modal-head-title {
  color: var(--text-primary, #1f2329);
  font-size: 34rpx;
  font-weight: bold;
}
.modal-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-muted, #f2f3f5);
  color: var(--text-secondary, #5f6771);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-close-hover {
  background: var(--border-input, #e7e9ec);
}
.modal-body {
  padding: 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary, #1f2329);
}
.modal-sub {
  font-size: 26rpx;
  color: var(--text-tertiary, #8a9099);
  margin: 16rpx 0 32rpx;
}
.step-chip {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-page, #f6f7f9);
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brand-600, #0b8f52);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.step-text {
  font-size: 28rpx;
  color: var(--text-primary, #1f2329);
}
.code-box {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx dashed var(--brand-600, #0b8f52);
  border-radius: 12rpx;
  background: var(--brand-50, #f2fbf6);
  padding: 36rpx 0;
  text-align: center;
  font-size: 56rpx;
  font-weight: bold;
  color: var(--brand-700, #0a7d4a);
  letter-spacing: 8rpx;
  margin-top: 12rpx;
}
.copied-tip {
  font-size: 26rpx;
  color: var(--brand-700, #0a7d4a);
  margin-top: 28rpx;
}
.modal-report {
  font-size: 26rpx;
  color: var(--text-placeholder, #b8bec6);
  margin-top: 24rpx;
}
.modal-report .report-link {
  margin-left: 8rpx;
}
