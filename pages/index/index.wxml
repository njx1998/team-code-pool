<!-- 页面结构从上到下：
     统计条 → 公告 → 账号状态 → 发码卡片 → 参与教程 → 我的记录 → 互助池列表
     顶部标题由微信原生导航栏显示（app.json 的 navigationBarTitleText） -->

<view class="page">

  <!-- ===== 统计条 ===== -->
  <view class="stats-card">
    <view class="stat-cell">
      <text class="stat-label">今天</text>
      <text class="stat-num">{{stats.todayCount}}</text>
      <text class="stat-label">人发码</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-cell">
      <text class="stat-label">可用</text>
      <text class="stat-num">{{stats.availableCount}}</text>
      <text class="stat-label">个</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-cell">
      <text class="stat-label">累计</text>
      <text class="stat-num">{{stats.totalText}}</text>
      <text class="stat-label">次</text>
    </view>
  </view>

  <!-- ===== 公告条 ===== -->
  <view class="notice-bar">
    <text class="notice-icon">ⓘ</text>
    <text class="notice-text">{{noticeText}}</text>
  </view>

  <!-- ===== 账号状态（点击查询） ===== -->
  <view class="account-row" hover-class="row-hover" bindtap="onCheckAccount">
    <view class="account-left">
      <text class="account-label">账号状态</text>
      <text class="account-status">{{accountStatus}}</text>
    </view>
    <text class="account-more">查看</text>
  </view>

  <!-- ===== 发码卡片 ===== -->
  <view class="card submit-card">
    <text class="submit-title">有码就发一个，没码就复制下面的</text>
    <view class="submit-row">
      <input
        class="submit-input"
        type="number"
        maxlength="9"
        placeholder="输入 8/9 位组队码"
        placeholder-class="input-placeholder"
        value="{{inputCode}}"
        focus="{{focusInput}}"
        bindinput="onInput"
      />
      <button class="submit-btn" hover-class="submit-btn-hover" bindtap="onSubmit">提交</button>
    </view>
  </view>

  <!-- ===== 参与教程（折叠） ===== -->
  <view class="fold-bar" hover-class="fold-hover" bindtap="toggleTutorial">
    <text class="fold-icon">?</text>
    <text class="fold-title">参与教程</text>
    <text class="fold-toggle">{{tutorialOpen ? '收起' : '展开'}}</text>
  </view>
  <view class="tutorial" wx:if="{{tutorialOpen}}">
    <text class="tut-item">1. 输入或粘贴 8/9 位 PDD组队码提交到互助池，等待其他用户获取后组队</text>
    <text class="tut-item">2. 点击下列表中的"复制"按钮，打开对应App，搜索复制的组队码组团</text>
    <text class="tut-item">3. 活动入口：PDD首页 → 百亿补贴 → 消费券福袋！（每日三次组队机会）</text>
  </view>

  <!-- ===== 我的记录（折叠） ===== -->
  <view class="fold-bar" hover-class="fold-hover" bindtap="toggleRecords">
    <text class="fold-icon">◔</text>
    <text class="fold-title">我的记录 · 可举报恶意码</text>
    <text class="fold-toggle">{{recordsOpen ? '收起' : '展开'}}</text>
  </view>
  <view class="records" wx:if="{{recordsOpen}}">
    <view class="tab-row">
      <view
        class="tab {{myTab === 'submitted' ? 'tab-active' : ''}}"
        data-tab="submitted"
        bindtap="onMyTab"
      >我提交的</view>
      <view
        class="tab {{myTab === 'copied' ? 'tab-active' : ''}}"
        data-tab="copied"
        bindtap="onMyTab"
      >我复制的</view>
    </view>

    <!-- 我提交的：码 + 日期 -->
    <block wx:if="{{myTab === 'submitted'}}">
      <view class="record-row" wx:for="{{mySubmitted}}" wx:key="id">
        <text class="record-code">{{item.codeMasked}}</text>
        <text class="record-date">{{item.dateText}}</text>
      </view>
    </block>

    <!-- 我复制的：码 + 日期 + 举报入口 -->
    <block wx:else>
      <view class="record-row" wx:for="{{myCopied}}" wx:key="id">
        <text class="record-code">{{item.codeMasked}}</text>
        <view class="record-right">
          <text class="record-date">{{item.dateText}}</text>
          <text class="report-link" data-id="{{item.id}}" bindtap="onReport">举报</text>
        </view>
      </view>
    </block>
  </view>

  <!-- ===== 大家刚发的码 ===== -->
  <view class="card pool-card">
    <view class="pool-header">
      <text class="pool-title">大家刚发的码</text>
      <text class="pool-avail">可用 {{stats.availableCount}}</text>
    </view>

    <view class="tab-row">
      <view class="tab {{listTab === 'all' ? 'tab-active' : ''}}" data-tab="all" bindtap="onListTab">全部</view>
      <view class="tab {{listTab === 'available' ? 'tab-active' : ''}}" data-tab="available" bindtap="onListTab">可用</view>
      <view class="tab {{listTab === 'used' ? 'tab-active' : ''}}" data-tab="used" bindtap="onListTab">已用</view>
    </view>

    <!-- 列表：filteredPool 已在 JS 里按 tab 过滤好 -->
    <view class="pool-item" wx:for="{{filteredPool}}" wx:key="id">
      <view class="pool-info">
        <text class="pool-code">{{item.codeMasked}}</text>
        <text class="pool-meta">{{item.digits}}位数 {{item.timeText}} 来自 {{item.ipMasked}}</text>
      </view>
      <view
        wx:if="{{item.status === 'available'}}"
        class="pill pill-copy"
        hover-class="pill-copy-hover"
        data-id="{{item.id}}"
        bindtap="onCopy"
      >复制</view>
      <view wx:else class="pill pill-used">已用</view>
    </view>

    <!-- 空态：当前 tab 下没有数据。可用 tab 的空态有引导文案和行动按钮 -->
    <view class="pool-empty-box" wx:if="{{filteredPool.length === 0}}">
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-sub" wx:if="{{listTab === 'available'}}">可以先发一个，后面的人就能帮你了</view>
      <view class="empty-btn" wx:if="{{listTab === 'available'}}" hover-class="empty-btn-hover" bindtap="onGoSubmit">去发一个码</view>
      <view class="empty-link" wx:if="{{listTab !== 'all'}}" hover-class="link-hover" bindtap="onSeeAll">查看全部记录 →</view>
    </view>
  </view>

  <!-- ===== 页脚 ===== -->
  <view class="page-footer">互帮互助 · 人人有份</view>

</view>

<!-- ===== 复制弹窗 ===== -->
<view class="modal-mask" wx:if="{{modal.visible}}" bindtap="onCloseModal">
  <view class="modal" catchtap="stopBubble">
    <view class="modal-head">
      <text class="modal-head-title">百亿补贴抽福袋</text>
      <view class="modal-close" hover-class="modal-close-hover" bindtap="onCloseModal">×</view>
    </view>
    <view class="modal-body">
      <text class="modal-title">搜索邀请码组队 双方可抽取优惠</text>
      <text class="modal-sub">完成 2 步，可与我组队一起抽券</text>
      <view class="step-chip"><text class="step-num">1</text><text class="step-text">打开对应 App</text></view>
      <view class="step-chip"><text class="step-num">2</text><text class="step-text">搜索以下数字邀请码</text></view>
      <view class="code-box">{{modal.code}}</view>
      <text class="copied-tip">✅ 邀请码已复制到剪贴板</text>
      <text class="modal-report">该码无法使用？<text class="report-link" data-id="{{modal.code}}" bindtap="onReport">立即举报</text></text>
    </view>
  </view>
</view>
